<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WFLTool.Windows.EulaWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="软件许可协议">

    <Grid x:Name="RootGrid" Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,16,24,10" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="4">
                <TextBlock x:Name="HeadingText" Text="WFL Tool 软件许可协议" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="UpdatedText" Text="内容更新日期：2026/03/08  ·  协议生效日期：2026/04/01"
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24,14,24,14" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="EulaText" TextWrapping="Wrap" LineHeight="23" IsTextSelectionEnabled="True" />
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,12,24,18" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                <TextBlock x:Name="PromptText" Text="我在仔细阅读后：" VerticalAlignment="Center" />
                <Button x:Name="ReadDoneButton" Grid.Column="1" Content="我看完了" Style="{StaticResource PillButtonStyle}"
                        Click="ReadDone_Click" Visibility="Collapsed" />
                <Button x:Name="DeclineButton" Grid.Column="2" Content="不接受" Style="{StaticResource PillButtonStyle}"
                        Click="Decline_Click" />
                <Button x:Name="AcceptButton" Grid.Column="3" Content="接受" Style="{StaticResource AccentButtonStyle}"
                        Click="Accept_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
