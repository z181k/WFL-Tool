<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WFLTool.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WFLTool.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" MaxWidth="1100">
        <Grid Padding="32,20,32,36" HorizontalAlignment="Stretch">
            <StackPanel Spacing="18">

                <InfoBar x:Name="BetaBar"
                         IsOpen="False"
                         Severity="Informational"
                         Title="测试版提示"
                         IsClosable="True"
                         CloseButtonClick="BetaBar_CloseButtonClick">
                    <InfoBar.ActionButton>
                        <Button Content="此版本不再显示" Click="BetaBar_DismissClick" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- 快速操作 -->
                <TextBlock Text="快速操作" Style="{StaticResource SectionTitleTextStyle}" />
                <ItemsRepeater ItemsSource="{x:Bind QuickItems}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="240" MinItemHeight="84"
                                           MinColumnSpacing="12" MinRowSpacing="12"
                                           ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:ToolItem">
                            <Button Style="{StaticResource ActionCardButtonStyle}"
                                    Tag="{x:Bind Tag}"
                                    Click="Tile_Click"
                                    RightTapped="Tile_RightTapped">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource IconTextStyle}"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleTextStyle}" />
                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource CardSubtitleTextStyle}" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                              Foreground="{ThemeResource MutedTextBrush}"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- 资源管理器 -->
                <TextBlock Text="Windows 资源管理器 功能" Style="{StaticResource SectionTitleTextStyle}" />
                <ItemsRepeater ItemsSource="{x:Bind ExplorerItems}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="220" MinItemHeight="78"
                                           MinColumnSpacing="12" MinRowSpacing="12"
                                           ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:ToolItem">
                            <Button Style="{StaticResource ActionCardButtonStyle}"
                                    Tag="{x:Bind Tag}"
                                    Click="Tile_Click"
                                    RightTapped="Tile_RightTapped">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource IconTextStyle}"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleTextStyle}" />
                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource CardSubtitleTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- 实用功能 -->
                <TextBlock Text="实用电脑功能 (电脑自带)" Style="{StaticResource SectionTitleTextStyle}" />
                <ItemsRepeater ItemsSource="{x:Bind ToolItems}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="250" MinItemHeight="80"
                                           MinColumnSpacing="12" MinRowSpacing="12"
                                           ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:ToolItem">
                            <Button Style="{StaticResource ActionCardButtonStyle}"
                                    Tag="{x:Bind Tag}"
                                    Click="Tile_Click"
                                    RightTapped="Tile_RightTapped"
                                    IsEnabled="{x:Bind IsEnabled}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource IconTextStyle}"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleTextStyle}" />
                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource CardSubtitleTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <TextBlock Text="© 2021-2026 董博涛. 保留所有权利.  ·  Apache-2.0 开源软件"
                           FontSize="11" Foreground="{ThemeResource MutedTextBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>
