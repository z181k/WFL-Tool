<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WFLTool.Pages.AccessoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WFLTool.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" MaxWidth="1100">
        <Grid Padding="32,20,32,36" HorizontalAlignment="Stretch">
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Click="BackButton_Click" Background="Transparent" BorderThickness="0"
                            Padding="8" Visibility="Collapsed" ToolTipService.ToolTip="返回">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    </Button>
                    <StackPanel Spacing="2">
                        <TextBlock Text="系统附件" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="Windows 自带的小工具与辅助功能"
                                   Style="{StaticResource PageSubtitleTextStyle}" />
                    </StackPanel>
                </StackPanel>

                <Border Background="{ThemeResource CardBackgroundBrush}"
                        BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16,12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="如果无法打开，请到 Windows 功能中启用相关功能；无法点击表示该系统不支持该功能。"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="Windows 功能" Style="{StaticResource PillButtonStyle}" Click="WindowsFeatures_Click" />
                            <Button x:Name="OptionalFeaturesButton" Content="可选功能" Style="{StaticResource PillButtonStyle}" Click="OptionalFeatures_Click" />
                            <Button Content="更多辅助功能" Style="{StaticResource PillButtonStyle}" Click="AccessibilityFolder_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="常用附件" Style="{StaticResource SectionTitleTextStyle}" />
                <ItemsRepeater ItemsSource="{x:Bind CommonItems}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="240" MinItemHeight="78"
                                           MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:ToolItem">
                            <Button Style="{StaticResource ActionCardButtonStyle}"
                                    Tag="{x:Bind Tag}" Click="Tile_Click"
                                    IsEnabled="{x:Bind IsEnabled, Mode=OneWay}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource IconTextStyle}"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleTextStyle}" />
                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource CardSubtitleTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <TextBlock Text="辅助功能" Style="{StaticResource SectionTitleTextStyle}" />
                <ItemsRepeater ItemsSource="{x:Bind AccessibilityItems}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="240" MinItemHeight="78"
                                           MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:ToolItem">
                            <Button Style="{StaticResource ActionCardButtonStyle}"
                                    Tag="{x:Bind Tag}" Click="Tile_Click">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource IconTextStyle}"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleTextStyle}" />
                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource CardSubtitleTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>
