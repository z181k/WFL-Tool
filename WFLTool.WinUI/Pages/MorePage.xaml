<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WFLTool.Pages.MorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WFLTool.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" MaxWidth="1100">
        <Grid Padding="32,20,32,36" HorizontalAlignment="Stretch">
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Click="BackButton_Click" Background="Transparent" BorderThickness="0"
                            Padding="8" Visibility="Collapsed" ToolTipService.ToolTip="返回">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    </Button>
                    <StackPanel Spacing="2">
                        <TextBlock Text="查看更多" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="Windows 自带的系统工具、管理控制台与疑难解答"
                                   Style="{StaticResource PageSubtitleTextStyle}" />
                    </StackPanel>
                </StackPanel>

                <Button x:Name="DefragHelpButton" Style="{StaticResource LinkButtonStyle}"
                        HorizontalAlignment="Left" Click="DefragHelp_Click"
                        Content="碎片整理和优化驱动器功能说明 (使用前必看)" />

                <TextBlock Text="系统与管理" Style="{StaticResource SectionTitleTextStyle}" />
                <ItemsRepeater ItemsSource="{x:Bind ManagementItems}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="250" MinItemHeight="80"
                                           MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:ToolItem">
                            <Button Style="{StaticResource ActionCardButtonStyle}"
                                    Tag="{x:Bind Tag}" Click="Tile_Click"
                                    IsEnabled="{x:Bind IsEnabled, Mode=OneWay}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource IconTextStyle}"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleTextStyle}" />
                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource CardSubtitleTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <TextBlock Text="安全与性能" Style="{StaticResource SectionTitleTextStyle}" />
                <ItemsRepeater ItemsSource="{x:Bind SecurityItems}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="250" MinItemHeight="80"
                                           MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:ToolItem">
                            <Button Style="{StaticResource ActionCardButtonStyle}"
                                    Tag="{x:Bind Tag}" Click="Tile_Click"
                                    IsEnabled="{x:Bind IsEnabled, Mode=OneWay}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource IconTextStyle}"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleTextStyle}" />
                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource CardSubtitleTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <TextBlock Text="信息、终端与疑难解答" Style="{StaticResource SectionTitleTextStyle}" />
                <ItemsRepeater ItemsSource="{x:Bind SupportItems}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="250" MinItemHeight="80"
                                           MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:ToolItem">
                            <Button Style="{StaticResource ActionCardButtonStyle}"
                                    Tag="{x:Bind Tag}" Click="Tile_Click" RightTapped="Tile_RightTapped"
                                    IsEnabled="{x:Bind IsEnabled, Mode=OneWay}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource IconTextStyle}"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleTextStyle}" />
                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource CardSubtitleTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>
