<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WFLTool.Pages.KmsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" MaxWidth="1100">
        <Grid Padding="32,20,32,36" HorizontalAlignment="Stretch">
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Click="BackButton_Click" Background="Transparent" BorderThickness="0"
                            Padding="8" Visibility="Collapsed" ToolTipService.ToolTip="返回">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    </Button>
                    <StackPanel Spacing="2">
                        <TextBlock Text="密钥管理服务" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="Windows KMS 激活 UI（需要自行准备 KMS 服务器地址）"
                                   Style="{StaticResource PageSubtitleTextStyle}" />
                    </StackPanel>
                </StackPanel>

                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                         Title="使用须知"
                         Message="使用 Windows 密钥管理服务 (KMS) 激活的 Windows 和 Office 每 180 天需要重新激活一次。我们没有内置 KMS 服务器地址，请自行准备；使用官方地址激活的是正版，我们只是给 KMS 做了个 UI，方便使用。" />

                <Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Windows 激活" Style="{StaticResource SectionTitleTextStyle}" Margin="0" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="查看激活状态" Style="{StaticResource PillButtonStyle}" Click="Status_Click" />
                            <Button Content="立即激活" Style="{StaticResource PillButtonStyle}" Click="Activate_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="安装密钥 / 设置 KMS 地址" Style="{StaticResource SectionTitleTextStyle}" Margin="0" />
                        <TextBlock Text="此功能需要先在下方输入需要应用的信息，然后再点击相关按钮。注意：IPv6 地址必须以“[计算机名]:端口”的格式指定。"
                                   TextWrapping="Wrap" Style="{StaticResource CardSubtitleTextStyle}" />
                        <TextBox x:Name="InputBox" PlaceholderText="在此输入产品密钥或 KMS 地址"
                                 FontFamily="Consolas" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="安装密钥" Style="{StaticResource PillButtonStyle}" Click="InstallKey_Click" />
                            <Button Content="设定 / 更改 KMS 地址" Style="{StaticResource PillButtonStyle}" Click="SetKms_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="切换 Windows 10/11 版本并安装相关 KMS 密钥" Style="{StaticResource SectionTitleTextStyle}" Margin="0" />
                        <TextBlock Text="安装对应版本的 KMS 客户端密钥（GVLK），安装后会自动替换当前密钥。"
                                   TextWrapping="Wrap" Style="{StaticResource CardSubtitleTextStyle}" />
                        <ItemsRepeater x:Name="EditionRepeater" ItemsSource="{x:Bind Editions}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="150" MinItemHeight="40"
                                                   MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Title}" Tag="{Binding Tag}" Click="Edition_Click"
                                            Style="{StaticResource PillButtonStyle}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="取消激活" Style="{StaticResource SectionTitleTextStyle}" Margin="0" />
                        <TextBlock Text="卸载当前产品密钥、重置激活计数，或通过电话激活。"
                                   TextWrapping="Wrap" Style="{StaticResource CardSubtitleTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="卸载密钥" Style="{StaticResource PillButtonStyle}" Click="UninstallKey_Click" />
                            <Button Content="重置激活" Style="{StaticResource PillButtonStyle}" Click="Rearm_Click" />
                            <Button Content="电话激活" Style="{StaticResource PillButtonStyle}" Click="PhoneActivate_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="以上操作会调用 Windows 自带的 slmgr.vbs / slui.exe，可能需要管理员权限。"
                           FontSize="11" Foreground="{ThemeResource MutedTextBrush}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>
