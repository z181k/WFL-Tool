<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WFLTool.Pages.TransparencyTutorialPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,20,32,28" HorizontalAlignment="Stretch" MaxWidth="1100">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="BackButton" Click="BackButton_Click" Background="Transparent" BorderThickness="0"
                    Padding="8" Visibility="Collapsed" ToolTipService.ToolTip="返回">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <StackPanel Spacing="2">
                <TextBlock Text="Windows 10 任务栏透明度设置教程" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="修改注册表前请先备份，操作需要重启资源管理器或 dwm.exe"
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <Button Content="复制全文" Style="{StaticResource PillButtonStyle}" Click="Copy_Click"
                    VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <TextBox x:Name="TutorialText" Grid.Row="1" Margin="0,16,0,0"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="12"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 VerticalAlignment="Stretch" />
    </Grid>
</Page>
