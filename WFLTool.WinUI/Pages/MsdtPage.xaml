<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WFLTool.Pages.MsdtPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WFLTool.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" MaxWidth="1100">
        <Grid Padding="32,20,32,36" HorizontalAlignment="Stretch">
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Click="BackButton_Click" Background="Transparent" BorderThickness="0"
                            Padding="8" Visibility="Collapsed" ToolTipService.ToolTip="返回">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    </Button>
                    <StackPanel Spacing="2">
                        <TextBlock Text="MSDT 疑难解答" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="Windows 支持诊断工具（部分系统已弃用）"
                                   Style="{StaticResource PageSubtitleTextStyle}" />
                    </StackPanel>
                </StackPanel>

                <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                         Title="MSDT 工具已弃用"
                         Message="请尽量不用这里的功能。Windows 11 24H2 及更高版本可能已移除 MSDT。">
                    <InfoBar.ActionButton>
                        <Button Content="了解更多" Click="LearnMore_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <ItemsRepeater ItemsSource="{x:Bind Items}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="240" MinItemHeight="80"
                                           MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:ToolItem">
                            <Button Style="{StaticResource ActionCardButtonStyle}"
                                    Tag="{x:Bind Tag}" Click="Tile_Click">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource IconTextStyle}"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleTextStyle}" />
                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource CardSubtitleTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>
