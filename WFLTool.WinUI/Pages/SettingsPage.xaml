<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WFLTool.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" MaxWidth="1100">
        <Grid x:Name="ContentGrid" Padding="32,20,32,36" HorizontalAlignment="Stretch">
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Click="BackButton_Click" Background="Transparent" BorderThickness="0"
                            Padding="8" Visibility="Collapsed" ToolTipService.ToolTip="返回">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    </Button>
                    <StackPanel Spacing="2">
                        <TextBlock Text="WFL Tool 选项" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="外观、窗口行为、打开方式与高级选项"
                                   Style="{StaticResource PageSubtitleTextStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- 外观 -->
                <Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20,16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="外观" Style="{StaticResource SectionTitleTextStyle}" Margin="0" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="主题" FontWeight="SemiBold" />
                            <RadioButtons x:Name="ThemeOptions" SelectionChanged="ThemeOptions_SelectionChanged">
                                <x:String>跟随系统</x:String>
                                <x:String>亮色</x:String>
                                <x:String>暗色</x:String>
                            </RadioButtons>
                            <TextBlock Text="保存后立即应用，无需重启应用。" Style="{StaticResource CardSubtitleTextStyle}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="主界面右上角显示样式" FontWeight="SemiBold" />
                            <RadioButtons x:Name="HomeStyleOptions" SelectionChanged="HomeStyleOptions_SelectionChanged">
                                <x:String>现代 (WFL Tool  v17.5)</x:String>
                                <x:String>伪旧 (欢迎使用  v17.5)</x:String>
                                <x:String>仅版本号 (v17.5)</x:String>
                                <x:String>仅软件名 (WFL Tool)</x:String>
                            </RadioButtons>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 窗口 -->
                <Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20,16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="窗口与通知区域" Style="{StaticResource SectionTitleTextStyle}" Margin="0" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="将本程序置顶显示" FontWeight="SemiBold" />
                                <TextBlock Text="置顶后弹窗将不使用 WinAppSDK 提供的样式。" Style="{StaticResource CardSubtitleTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="TopmostSwitch" Grid.Column="1" OnContent="已置顶" OffContent="不置顶"
                                          Toggled="TopmostSwitch_Toggled" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="通知区域 (托盘) 图标" FontWeight="SemiBold" />
                                <TextBlock Text="打开后关闭主界面不会退出程序；设置重启应用生效。" Style="{StaticResource CardSubtitleTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="TraySwitch" Grid.Column="1" OnContent="显示" OffContent="不显示"
                                          Toggled="TraySwitch_Toggled" />
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="查看更多和系统附件的打开方式" FontWeight="SemiBold" />
                            <RadioButtons x:Name="OpenModeOptions" SelectionChanged="OpenModeOptions_SelectionChanged">
                                <x:String>新版：当前窗口内打开，带返回键</x:String>
                                <x:String>旧版：弹出独立窗口</x:String>
                            </RadioButtons>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 查看更多内部功能 -->
                <Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="查看更多内部功能" Style="{StaticResource SectionTitleTextStyle}" Margin="0" />
                        <TextBlock Text="决定“查看更多”页中“计算机管理”按钮实际执行的操作。"
                                   Style="{StaticResource CardSubtitleTextStyle}" />
                        <RadioButtons x:Name="CctOptions" SelectionChanged="CctOptions_SelectionChanged">
                            <x:String>计算机管理</x:String>
                            <x:String>管理员命令提示符</x:String>
                            <x:String>旧版任务管理器 (Win11 22H2+)</x:String>
                        </RadioButtons>
                    </StackPanel>
                </Border>

                <!-- 数据 -->
                <Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="数据与退出" Style="{StaticResource SectionTitleTextStyle}" Margin="0" />
                        <Button x:Name="ResetExplorerPromptButton" Content="恢复 关闭/重启资源管理器的提示"
                                Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Left"
                                Click="ResetExplorerPrompt_Click" Visibility="Collapsed" />
                        <Button Content="清除软件使用时产生的数据并退出程序" Style="{StaticResource PillButtonStyle}"
                                HorizontalAlignment="Left" Click="ClearData_Click" />
                        <TextBlock Text="清除数据不会撤回协议同意。此操作会清除应用的所有设置并关闭应用。"
                                   Style="{StaticResource CardSubtitleTextStyle}" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="VersionFooter" FontSize="11" Foreground="{ThemeResource MutedTextBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>
