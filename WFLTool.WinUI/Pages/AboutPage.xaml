<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WFLTool.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WFLTool.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" MaxWidth="1100">
        <Grid Padding="32,20,32,36" HorizontalAlignment="Stretch">
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Click="BackButton_Click" Background="Transparent" BorderThickness="0"
                            Padding="8" Visibility="Collapsed" ToolTipService.ToolTip="返回">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    </Button>
                    <StackPanel Spacing="2">
                        <TextBlock Text="关于" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="WFL Tool · 电脑功能启动器" Style="{StaticResource PageSubtitleTextStyle}" />
                    </StackPanel>
                </StackPanel>

                <Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="24">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                        <Border Width="96" Height="96" CornerRadius="22" Background="{ThemeResource AccentSoftBrush}">
                            <Image x:Name="AboutLogo" Margin="16" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="WFL Tool" FontSize="28" FontWeight="SemiBold" />
                                <Border x:Name="BetaBadge" Background="{ThemeResource AccentSoftBrush}" CornerRadius="9"
                                        Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="BetaText" FontSize="11" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="方便快捷 一点即达" Style="{StaticResource PageSubtitleTextStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
                                <TextBlock x:Name="VersionText" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                <TextBlock x:Name="BuildText" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                <TextBlock x:Name="ArchText" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20,16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="WFL Tool 让修改系统变得更加容易，让系统附件更加易于寻找。" TextWrapping="Wrap" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}">
                            版权所有 © 2021-2026 董博涛. 保留所有权利。
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}">
                            本软件是 Apache-2.0 许可证的开源软件。使用本软件源码需同时遵守 WFL Tool 软件许可协议和 Apache-2.0 许可证。
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}">
                            应用中部分链接为非本团队运营，详见软件许可协议。
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="帮助与信息" Style="{StaticResource SectionTitleTextStyle}" />
                <ItemsRepeater ItemsSource="{x:Bind Links}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="210" MinItemHeight="42"
                                           MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:ToolItem">
                            <Button Content="{x:Bind Title}" Tag="{x:Bind Tag}" Click="Link_Click"
                                    Style="{StaticResource PillButtonStyle}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    ToolTipService.ToolTip="{x:Bind Description}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20,16">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="软件大事记" Style="{StaticResource SectionTitleTextStyle}" Margin="0" />
                            <Button Grid.Column="1" Content="展开 / 收起" Style="{StaticResource LinkButtonStyle}"
                                    Click="HistoryToggle_Click" />
                        </Grid>
                        <TextBlock x:Name="HistoryText" Visibility="Collapsed" TextWrapping="Wrap"
                                   Text="2021/5/9 发布第一个版本 (V2.0.0)&#x0a;2022/7/7 发布第一个 64 位版本 (V7.0.0.0)&#x0a;2023/1/10 基于 .NET Fx 4.5.2 重构&#x0a;2023/05/25 主要名字更名英文 WFL Tool&#x0a;2024/01/01 应用界面翻新工作基本完成&#x0a;2025/08/06 更换新图标&#x0a;2025/11/25 推出 .NET 10 版本，支持暗色模式&#x0a;2026/11/13 测试使用 WinUI3 重写" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>
