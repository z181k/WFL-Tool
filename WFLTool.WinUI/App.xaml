<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WFLTool.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#99000000" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#15005FB8" />
                    <SolidColorBrush x:Key="HeroGradientStartBrush" Color="#FF005FB8" />
                    <SolidColorBrush x:Key="HeroGradientEndBrush" Color="#FF8764B8" />
                    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFFFF4CE" />
                    <SolidColorBrush x:Key="WarningBorderBrush" Color="#33FF8C00" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0F000000" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#14000000" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#14000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#202020" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#A6FFFFFF" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#26A6C8FF" />
                    <SolidColorBrush x:Key="HeroGradientStartBrush" Color="#FF60CDFF" />
                    <SolidColorBrush x:Key="HeroGradientEndBrush" Color="#FFB48CFF" />
                    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#33FFD54F" />
                    <SolidColorBrush x:Key="WarningBorderBrush" Color="#66FFD54F" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#33FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="HeroGradientStartBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="HeroGradientEndBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WarningBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,8,0,4" />
            </Style>

            <Style x:Key="ActionCardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="72" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="PillButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="MinHeight" Value="32" />
            </Style>

            <Style x:Key="LinkButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="MinHeight" Value="28" />
            </Style>

            <Style x:Key="IconTextStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="20" />
            </Style>

            <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="CardSubtitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
